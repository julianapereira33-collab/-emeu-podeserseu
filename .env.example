NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Chave secreta (nunca prefixar com NEXT_PUBLIC_) — Project Settings > API Keys > service_role,
# no painel do Supabase. Usada só pelo webhook de pagamento, que roda sem sessão de usuário.
SUPABASE_SERVICE_ROLE_KEY=

# Access Token do Mercado Pago (developers.mercadopago.com.br > Suas integrações > Credenciais).
# Use o de teste (TEST-...) para validar o fluxo antes de trocar pelo de produção (APP_USR-...).
MERCADO_PAGO_ACCESS_TOKEN=

# Public Key do Mercado Pago (mesma tela de Credenciais que o Access Token acima, campo separado).
# Usada no navegador pelo Wallet Brick (Pix/cartão/boleto num modal). Sem ela, o botão de pagar
# não consegue abrir o checkout — precisa estar definida ANTES do build (é NEXT_PUBLIC_).
NEXT_PUBLIC_MERCADO_PAGO_PUBLIC_KEY=

# Opcional — sugestão de preço por IA no cadastro de peça
ANTHROPIC_API_KEY=

# Opcional — geração de foto editorial (troca fundo/modelo) via gpt-image-1.
# platform.openai.com/api-keys. Cobrado por imagem gerada.
OPENAI_API_KEY=