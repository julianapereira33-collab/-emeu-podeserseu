NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Chave secreta (nunca prefixar com NEXT_PUBLIC_) — Project Settings > API Keys > service_role,
# no painel do Supabase. Usada só pelo webhook de pagamento, que roda sem sessão de usuário.
SUPABASE_SERVICE_ROLE_KEY=

# Access Token do Mercado Pago (developers.mercadopago.com.br > Suas integrações > Credenciais).
# Use o de teste (TEST-...) para validar o fluxo de Pix antes de trocar pelo de produção (APP_USR-...).
MERCADO_PAGO_ACCESS_TOKEN=

# Opcional — sugestão de preço por IA no cadastro de peça
ANTHROPIC_API_KEY=

# Opcional — geração de foto editorial (troca fundo/modelo) via gpt-image-1.
# platform.openai.com/api-keys. Cobrado por imagem gerada.
OPENAI_API_KEY=
